# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
# Build output — the zipapp is a build artifact, not source. Build it with
# ./scripts/build_standalone.sh (and in CI); don't commit it.
build/standalone/
dist/

# Downloaded Piper voice models (large; fetched on first --speak)
voices/
*.onnx
*.onnx.json

# Demo output
*.wav

# Local scratch / experiments
cmd
voxs

# Personal auth tokens / endpoints (secrets — never commit; written by the UI)
statemediafm.auth.toml
*.auth.toml

# Commercial license key (never commit)
statemediafm.license
*.license

# Persisted UI settings (non-secret, per-install; see examples/config.toml)
statemediafm.config.toml
